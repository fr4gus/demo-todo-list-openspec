# Copy to .env and fill in the required values. Never commit .env.

# --- Required secrets -------------------------------------------------------
# Signing key for JWTs (min. 32 characters). The backend refuses to start without it.
# Generate one with: openssl rand -base64 48
JWT_SECRET=

# --- Build / ports ----------------------------------------------------------
# Dockerfile target for frontend and backend: dev (default) or prod.
BUILD_TARGET=dev
FRONTEND_PORT=5173
BACKEND_PORT=8080
MAILPIT_UI_PORT=8025
SERVER_PORT=8080

# --- CORS -------------------------------------------------------------------
# The single browser origin allowed to call the API.
FRONTEND_ORIGIN=http://localhost:5173

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=todo
POSTGRES_USER=todo
POSTGRES_PASSWORD=todo_dev_password

# --- Redis ------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- SMTP (Mailpit in the local stack) --------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
